			netc_bus1: pcie@4cb00000 {
				compatible = "pci-host-ecam-generic";
				reg = <0x00 0x4cb00000 0x00 0x100000>;
				#address-cells = <0x03>;
				#size-cells = <0x02>;
				device_type = "pci";
				bus-range = <0x01 0x01>;
				ranges = <0x82000000 0x00 0x4cce0000 0x00 0x4cce0000 0x00 0x20000 0xc2000000 0x00 0x4cd10000 0x00 0x4cd10000 0x00 0x10000>;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x131 0x04>;
