							phandle = <0x65>;
						};
					};

					port@1 {
						reg = <0x01>;
					};
				};

				channel@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;
					phys = <0x6b>;
					phy-names = "lvds_phy";
