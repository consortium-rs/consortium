					reg = <0x00>;
					#phy-cells = <0x00>;
					phandle = <0x69>;
				};
			};

			ldb1_phy: phy@c {
				compatible = "fsl,imx95-lvds1-phy";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x0c 0x04>;
				gpr = <0x68>;
				clocks = <0x11 0x4b>;
				clock-names = "apb";
				power-domains = <0x51 0x0d>;
				status = "okay";
				phandle = <0x124>;

				ldb1_phy1: port@0 {
					reg = <0x00>;
					#phy-cells = <0x00>;
					phandle = <0x6b>;
				};
			};
