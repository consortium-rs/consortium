	pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x01 0x07 0x3f04>;
	};

	thermal_zones: thermal-zones {
		phandle = <0xba>;

		a55-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x7d0>;
			thermal-sensors = <0x18 0x01>;

			trips {

				cpu_alert0: trip0 {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x19>;
				};

				cpu_crit0: trip1 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0xbb>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x19>;
					cooling-device = <0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff 0x0f 0xffffffff 0xffffffff 0x10 0xffffffff 0xffffffff>;
				};
			};
		};

		ana-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x7d0>;
			thermal-sensors = <0x18 0x00>;

			trips {

				ana_alert: trip0 {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x1a>;
				};

				ana_crit0: trip1 {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x1d>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x1a>;
					cooling-device = <0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff 0x0f 0xffffffff 0xffffffff 0x10 0xffffffff 0xffffffff 0x1b 0xffffffff 0xffffffff 0x1c 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x1d>;
					cooling-device = <0x1b 0xffffffff 0x01>;
				};
			};
		};

		pf09 {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x7d0>;
			thermal-sensors = <0x18 0x02>;

			trips {

				pf09_alert: trip0 {
					temperature = <0x222e0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xbc>;
				};

				pf09_crit: trip1 {
					temperature = <0x25d78>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0xbd>;
				};
			};
		};

		pf53_arm {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x7d0>;
			thermal-sensors = <0x18 0x04>;

			trips {

				pf5301_alert: trip0 {
					temperature = <0x222e0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x1e>;
				};

				pf5301_crit: trip1 {
					temperature = <0x25d78>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0xbe>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x1e>;
					cooling-device = <0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff 0x0f 0xffffffff 0xffffffff 0x10 0xffffffff 0xffffffff>;
				};
			};
		};

		pf53_soc {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x7d0>;
			thermal-sensors = <0x18 0x03>;

			trips {

				pf5302_alert: trip0 {
					temperature = <0x222e0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xbf>;
				};

				pf5302_crit: trip1 {
					temperature = <0x25d78>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0xc0>;
				};
			};
		};
