/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "fsl,frdm-imx95", "fsl,imx95";
	model = "NXP FRDM-IMX95";

	dbg-shm-uio@20484000 {
		status = "okay";
		reg = <0x00 0x20484000 0x00 0x2000>;
		memory-region = <0x14f>;
		compatible = "generic-uio";
	};

	mu7@42430000 {
		status = "okay";
		interrupts = <0x00 0xea 0x04>;
		interrupt-parent = <0x01>;
		reg = <0x00 0x42430000 0x00 0x20000>;
		compatible = "generic-uio";
	};

	ipc-shm-uio@20480000 {
		status = "okay";
		reg = <0x00 0x20480000 0x00 0x4000>;
		memory-region = <0x14e>;
		compatible = "generic-uio";
	};

	aliases {
		gpio0 = "/soc/gpio@47400000";
		gpio1 = "/soc/gpio@43810000";
		gpio2 = "/soc/gpio@43820000";
		gpio3 = "/soc/gpio@43840000";
		gpio4 = "/soc/gpio@43850000";
		i2c0 = "/soc/bus@44000000/i2c@44340000";
		i2c1 = "/soc/bus@44000000/i2c@44350000";
		i2c2 = "/soc/bus@42000000/i2c@42530000";
		i2c3 = "/soc/bus@42000000/i2c@42540000";
		i2c4 = "/soc/bus@42000000/i2c@426b0000";
		i2c5 = "/soc/bus@42000000/i2c@426c0000";
		i2c6 = "/soc/bus@42000000/i2c@426d0000";
		i2c7 = "/soc/bus@42000000/i2c@426e0000";
		mmc0 = "/soc/bus@42800000/mmc@42850000";
		mmc1 = "/soc/bus@42800000/mmc@42860000";
		mmc2 = "/soc/bus@42800000/mmc@428b0000";
		serial0 = "/soc/bus@44000000/serial@44380000";
		serial1 = "/soc/bus@44000000/serial@44390000";
		serial2 = "/soc/bus@42000000/serial@42570000";
		serial3 = "/soc/bus@42000000/serial@42580000";
		serial4 = "/soc/bus@42000000/serial@42590000";
		serial5 = "/soc/bus@42000000/serial@425a0000";
		serial6 = "/soc/bus@42000000/serial@42690000";
		serial7 = "/soc/bus@42000000/serial@426a0000";
		ethernet0 = "/soc/system-controller@4cde0000/pcie@4ca00000/ethernet@0,0";
		ethernet1 = "/soc/system-controller@4cde0000/pcie@4ca00000/ethernet@8,0";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		idle-states {
			entry-method = "psci";

			cpu_pd_wait: cpu-pd-wait {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10033>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x1b58>;
				min-residency-us = <0x6978>;
				wakeup-latency-us = <0x3a98>;
				phandle = <0x02>;
			};
		};

		A55_0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03 0x08>;
			power-domain-names = "perf";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			phandle = <0x0b>;
		};

		A55_1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03 0x08>;
			power-domain-names = "perf";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x05>;
			phandle = <0x0c>;
		};

		A55_2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03 0x08>;
			power-domain-names = "perf";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x06>;
			phandle = <0x0d>;
		};

		A55_3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03 0x08>;
			power-domain-names = "perf";
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x07>;
			phandle = <0x0e>;
		};

		A55_4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			power-domains = <0x03 0x08>;
			power-domain-names = "perf";
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x02>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x08>;
			phandle = <0x0f>;
		};

		A55_5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			power-domains = <0x03 0x08>;
			power-domain-names = "perf";
			enable-method = "psci";
			#cooling-cells = <0x02>;
			cpu-idle-states = <0x02>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x09>;
			phandle = <0x10>;
		};

		l2_cache_l0: l2-cache-l0 {
			compatible = "cache";
			cache-size = <0x10000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <0x0a>;
			phandle = <0x04>;
		};

		l2_cache_l1: l2-cache-l1 {
			compatible = "cache";
			cache-size = <0x10000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <0x0a>;
			phandle = <0x05>;
		};

		l2_cache_l2: l2-cache-l2 {
			compatible = "cache";
			cache-size = <0x10000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <0x0a>;
			phandle = <0x06>;
		};

		l2_cache_l3: l2-cache-l3 {
			compatible = "cache";
			cache-size = <0x10000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <0x0a>;
			phandle = <0x07>;
		};

		l2_cache_l4: l2-cache-l4 {
			compatible = "cache";
			cache-size = <0x10000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <0x0a>;
			phandle = <0x08>;
		};

		l2_cache_l5: l2-cache-l5 {
			compatible = "cache";
			cache-size = <0x10000>;
			cache-line-size = <0x40>;
			cache-sets = <0x100>;
			cache-level = <0x02>;
			cache-unified;
			next-level-cache = <0x0a>;
			phandle = <0x09>;
		};

		l3_cache: l3-cache {
			compatible = "cache";
			cache-size = <0x80000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
			cache-level = <0x03>;
			cache-unified;
			phandle = <0x0a>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};

				core2 {
					cpu = <0x0d>;
				};

				core3 {
					cpu = <0x0e>;
				};

				core4 {
					cpu = <0x0f>;
				};

				core5 {
					cpu = <0x10>;
				};
			};
		};
	};

	reg_dummy: reg_dummy {
		compatible = "regulator-fixed";
		regulator-name = "reg_dummy";
		phandle = <0xa8>;
	};

	dummy: clock-dummy {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "dummy";
		phandle = <0x37>;
	};

	clk_ext1: clock-ext1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x7ed6b40>;
		clock-output-names = "clk_ext1";
		phandle = <0xa9>;
	};

	sai1_mclk: clock-sai-mclk1 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "sai1_mclk";
		phandle = <0xaa>;
	};

	sai2_mclk: clock-sai-mclk2 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "sai2_mclk";
		phandle = <0xab>;
	};

	sai3_mclk: clock-sai-mclk3 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "sai3_mclk";
		phandle = <0xac>;
	};

	sai4_mclk: clock-sai-mclk4 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "sai4_mclk";
		phandle = <0xad>;
	};

	sai5_mclk: clock-sai-mclk5 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		clock-output-names = "sai5_mclk";
		phandle = <0xae>;
	};

	clk_sys100m: clock-sys100m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "clk_sys100m";
		phandle = <0x78>;
	};

	osc_24m: clock-24m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "osc_24m";
		phandle = <0x49>;
	};

	ldb_pll_pixel: ldb_pll_div7 {
		#clock-cells = <0x00>;
		compatible = "fixed-factor-clock";
		clocks = <0x11 0x26>;
		clock-div = <0x07>;
		clock-mult = <0x01>;
		clock-output-names = "ldb_pll_div7";
		phandle = <0x73>;
	};

	mqs1: mqs1 {
		compatible = "fsl,imx95-aonmix-mqs";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0x12>;
		clocks = <0x11 0x3a>;
		clock-names = "mclk";
		#sound-dai-cells = <0x00>;
		phandle = <0xaf>;

		mqs1_port: port {
			dai-format = "left_j";
			playback-only;
			phandle = <0xb0>;

			mqs1_endpoint: endpoint {
				remote-endpoint = <0x13>;
				phandle = <0x4e>;
			};
		};
	};

	mqs2: mqs2 {
		compatible = "fsl,imx95-netcmix-mqs";
		status = "disabled";
		phandle = <0xb1>;
	};

	sram1: sram@204c0000 {
		compatible = "mmio-sram";
		reg = <0x00 0x204c0000 0x00 0x18000>;
		ranges = <0x00 0x00 0x204c0000 0x18000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		phandle = <0x8c>;
	};

	firmware {

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x14 0x05 0x00 0x14 0x03 0x00 0x14 0x03 0x01 0x14 0x05 0x01>;
			shmem = <0x15 0x16>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			arm,max-rx-timeout-ms = <0x1388>;
			max-rx-timeout-ms = <0x1388>;

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <0x01>;
				phandle = <0x51>;
			};

			scmi_sys_power: protocol@12 {
				reg = <0x12>;
				phandle = <0xb2>;
			};

			scmi_perf: protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x03>;
			};

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x11>;
			};

			scmi_sensor: protocol@15 {
				reg = <0x15>;
				#thermal-sensor-cells = <0x01>;
				phandle = <0x18>;
			};

			scmi_iomuxc: protocol@19 {
				reg = <0x19>;
				pinctrl-names = "default";
				pinctrl-0 = <0x17>;
				phandle = <0x48>;

				pinctrl_hog: hoggrp {
					fsl,pins = <0x190 0x394 0x00 0x05 0x00 0x31e>;
					phandle = <0x17>;
				};

				pinctrl_flexcan2: flexcan2grp {
					fsl,pins = <0x74 0x278 0x00 0x02 0x00 0x39e 0x7c 0x280 0x444 0x02 0x02 0x39e>;
					phandle = <0x35>;
				};

				pinctrl_flexcan5: flexcan5grp {
					fsl,pins = <0x68 0x26c 0x00 0x03 0x00 0x39e 0x6c 0x270 0x450 0x03 0x00 0x39e>;
					phandle = <0x39>;
				};

				pinctrl_lpi2c1: lpi2c1grp {
					fsl,pins = <0x1c0 0x3c4 0x00 0x00 0x00 0x40000b9e 0x1c4 0x3c8 0x00 0x00 0x00 0x40000b9e>;
					phandle = <0xb3>;
				};

				pinctrl_lpi2c2: lpi2c2grp {
					fsl,pins = <0x1c8 0x3cc 0x00 0x00 0x00 0x40000b9e 0x1cc 0x3d0 0x00 0x00 0x00 0x40000b9e>;
					phandle = <0x4b>;
				};

				pinctrl_lpi2c3: lpi2c3grp {
					fsl,pins = <0x80 0x284 0x504 0x11 0x01 0x40000b9e 0x84 0x288 0x500 0x11 0x01 0x40000b9e>;
					phandle = <0x29>;
				};

				pinctrl_lpi2c4: lpi2c4grp {
					fsl,pins = <0x88 0x28c 0x50c 0x11 0x01 0x40000b9e 0x8c 0x290 0x508 0x11 0x01 0x40000b9e>;
					phandle = <0x2e>;
				};

				pinctrl_pcal6524: pcal6524grp {
					fsl,pins = <0x98 0x29c 0x00 0x00 0x00 0x31e>;
					phandle = <0x4c>;
				};

				pinctrl_uart1: uart1grp {
					fsl,pins = <0x1d0 0x3d4 0x00 0x00 0x00 0x31e 0x1d4 0x3d8 0x00 0x00 0x00 0x31e>;
					phandle = <0x4d>;
				};

				pinctrl_uart5: uart5grp {
					fsl,pins = <0x0c 0x210 0x574 0x06 0x00 0x31e 0x00 0x204 0x570 0x06 0x00 0x31e 0x04 0x208 0x00 0x06 0x00 0x31e 0x08 0x20c 0x56c 0x06 0x00 0x31e>;
					phandle = <0x34>;
				};

				pinctrl_enetc0: enetc0grp {
					fsl,pins = <0xc0 0x2c4 0x00 0x00 0x00 0x50e 0xc4 0x2c8 0x00 0x00 0x00 0x50e 0xc8 0x2cc 0x00 0x00 0x00 0x50e 0xcc 0x2d0 0x00 0x00 0x00 0x50e 0xd0 0x2d4 0x00 0x00 0x00 0x57e 0xd4 0x2d8 0x00 0x00 0x00 0x58e 0xd8 0x2dc 0x00 0x00 0x00 0x57e 0xdc 0x2e0 0x00 0x00 0x00 0x58e 0xe0 0x2e4 0x00 0x00 0x00 0x57e 0xe4 0x2e8 0x00 0x00 0x00 0x57e 0xe8 0x2ec 0x00 0x00 0x00 0x57e 0xec 0x2f0 0x00 0x00 0x00 0x57e>;
					phandle = <0x83>;
				};

				pinctrl_enetc1: enetc1grp {
					fsl,pins = <0xf8 0x2fc 0x00 0x00 0x00 0x50e 0xfc 0x300 0x00 0x00 0x00 0x50e 0x100 0x304 0x00 0x00 0x00 0x50e 0x104 0x308 0x00 0x00 0x00 0x50e 0x108 0x30c 0x00 0x00 0x00 0x57e 0x10c 0x310 0x00 0x00 0x00 0x58e 0x110 0x314 0x00 0x00 0x00 0x57e 0x114 0x318 0x00 0x00 0x00 0x58e 0x118 0x31c 0x00 0x00 0x00 0x57e 0x11c 0x320 0x00 0x00 0x00 0x57e 0x120 0x324 0x00 0x00 0x00 0x57e 0x124 0x328 0x00 0x00 0x00 0x57e>;
					phandle = <0x86>;
				};

				pinctrl_emdio: emdiogrp {
					fsl,pins = <0xf0 0x2f4 0x424 0x00 0x01 0x50e 0xf4 0x2f8 0x428 0x00 0x01 0x90e>;
					phandle = <0x89>;
				};

				pinctrl_mipi_dsi_csi: mipidsigrp {
					fsl,pins = <0xa8 0x2ac 0x00 0x05 0x00 0x31e>;
					phandle = <0xb4>;
				};

				pinctrl_ekey_pwr: ekeypwrgrp {
					fsl,pins = <0x19c 0x3a0 0x00 0x05 0x00 0x31e>;
					phandle = <0x99>;
				};

				pinctrl_mkey_pwr: mkeypwrgrp {
					fsl,pins = <0x198 0x39c 0x00 0x05 0x00 0x31e>;
					phandle = <0x9a>;
				};

				pinctrl_mqs1: mqs1grp {
					fsl,pins = <0x1ec 0x3f0 0x00 0x04 0x00 0x31e 0x1f8 0x3fc 0x00 0x04 0x00 0x31e>;
					phandle = <0x12>;
				};

				pinctrl_pcie0: pcie0grp {
					fsl,pins = <0x90 0x294 0x00 0x01 0x00 0x40000b1e 0x94 0x298 0x00 0x00 0x00 0x31e>;
					phandle = <0x7f>;
				};

				pinctrl_pdm: pdmgrp {
					fsl,pins = <0x1e0 0x3e4 0x00 0x00 0x00 0x31e 0x1e4 0x3e8 0x40c 0x00 0x00 0x31e>;
					phandle = <0x4f>;
				};

				pinctrl_ptn5110: ptn5110grp {
					fsl,pins = <0x17c 0x380 0x00 0x05 0x00 0x31e>;
					phandle = <0x2b>;
				};

				pinctrl_sai5: sai5grp {
					fsl,pins = <0x180 0x384 0x00 0x01 0x00 0x31e 0x184 0x388 0x5c4 0x01 0x01 0x31e 0x188 0x38c 0x5c0 0x01 0x01 0x31e 0x18c 0x390 0x5ac 0x01 0x01 0x31e>;
					phandle = <0x38>;
				};

				pinctrl_usdhc1: usdhc1grp {
					fsl,pins = <0x128 0x32c 0x00 0x00 0x00 0x158e 0x12c 0x330 0x00 0x00 0x00 0x138e 0x130 0x334 0x00 0x00 0x00 0x138e 0x134 0x338 0x00 0x00 0x00 0x138e 0x138 0x33c 0x00 0x00 0x00 0x138e 0x13c 0x340 0x00 0x00 0x00 0x138e 0x140 0x344 0x00 0x00 0x00 0x138e 0x144 0x348 0x00 0x00 0x00 0x138e 0x148 0x34c 0x00 0x00 0x00 0x138e 0x14c 0x350 0x00 0x00 0x00 0x138e 0x150 0x354 0x00 0x00 0x00 0x158e>;
					phandle = <0x3a>;
				};

