				clock-names = "per", "ipg";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				dmas = <0x4a 0x0e 0x00 0x00 0x4a 0x0f 0x00 0x01>;
				dma-names = "tx", "rx";
				status = "okay";
				clock-frequency = <0x61a80>;
				pinctrl-names = "default";
				pinctrl-0 = <0x4b>;
				phandle = <0xfd>;

				pcal6524: gpio@22 {
					compatible = "nxp,pcal6524";
					pinctrl-names = "default";
					pinctrl-0 = <0x4c>;
					reg = <0x22>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					interrupt-parent = <0x2a>;
					interrupts = <0x0e 0x08>;
					gpio-line-names = "ENET1 PHY reset", "ENET2 PHY reset", "SPI3/GPIO select", "UART3/GPIO select", "CAN2&5/GPIO select", "PWM/GPIO select", "Watch dog enable", "CAN1&2&5 silent or normal select", "Wifi reset", "Wifi power down and IO EXP reset", "Bluetooth reset", "Mkey Power Enable", "", "", "", "USB Power Enable", "MIPI-DSI panel touch reset", "MIPI-DSI and CSI reset", "MIPI-DSI panel backlight enable (Reserved)", "MIPI-CSI camera reset", "LVDS panel touch reset", "LVDS panel backlight enable", "LVDS panel backlight power enable", "LVDS to HDMI converter IT6263 reset";
					phandle = <0x2f>;

					lpspi-gpio-sel-hog {
						gpio-hog;
						gpios = <0x02 0x00>;
						output-low;
					};

					lpuart-gpio-sel-hog {
						gpio-hog;
						gpios = <0x03 0x00>;
						output-low;
					};

					can-gpio-sel-hog {
						gpio-hog;
						gpios = <0x04 0x00>;
						output-low;
					};

					pwm-gpio-sel-hog {
						gpio-hog;
						gpios = <0x05 0x00>;
						output-high;
					};
				};

				pcal6408_b: gpio@20 {
					compatible = "nxp,pcal9554b";
					reg = <0x20>;
					gpio-controller;
					#gpio-cells = <0x02>;
					vcc-supply = <0x47>;
					status = "okay";
					phandle = <0xfe>;

					iw610-buffer-enable-hog {
						gpio-hog;
						gpios = <0x00 0x00>;
						output-high;
					};
				};
			};

