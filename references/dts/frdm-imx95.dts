		};

		opp-800000000 {
			opp-hz = <0x00 0x2faf0800>;
			opp-hz-real = <0x00 0x2faf0800>;
			opp-microvolt = <0xe09c0>;
		};

		opp-1000000000 {
			opp-hz = <0x00 0x3b9aca00>;
			opp-hz-real = <0x00 0x3b9aca00>;
			opp-microvolt = <0xe09c0>;
		};
