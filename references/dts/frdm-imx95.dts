				clocks = <0x11 0x77 0x11 0x80>;
				clock-names = "pclk", "fast_clk";
				status = "disabled";
				phandle = <0xce>;
			};

			lpi2c3: i2c@42530000 {
				compatible = "fsl,imx95-lpi2c", "fsl,imx7ulp-lpi2c";
				reg = <0x42530000 0x10000>;
				interrupts = <0x00 0x3a 0x04>;
				clocks = <0x11 0x81 0x11 0x77>;
				clock-names = "per", "ipg";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				dmas = <0x28 0x08 0x00 0x00 0x28 0x09 0x00 0x01>;
				dma-names = "tx", "rx";
				status = "okay";
				clock-frequency = <0x61a80>;
				pinctrl-names = "default";
				pinctrl-0 = <0x29>;
				phandle = <0xcf>;

				ptn5110: tcpc@50 {
					compatible = "nxp,ptn5110";
					reg = <0x50>;
					interrupt-parent = <0x2a>;
					interrupts = <0x03 0x08>;
					pinctrl-names = "default";
					pinctrl-0 = <0x2b>;
					phandle = <0xd0>;

					typec_con: connector {
						compatible = "usb-c-connector";
						label = "USB-C";
						power-role = "dual";
						data-role = "dual";
						try-power-role = "sink";
						source-pdos = <0x401912c>;
						sink-pdos = <0x401912c 0x9901912c>;
						op-sink-microwatt = <0xe4e1c0>;
						self-powered;
						phandle = <0xd1>;

						ports {
							#address-cells = <0x01>;
							#size-cells = <0x00>;

							port@0 {
								reg = <0x00>;

								typec_con_hs: endpoint {
									remote-endpoint = <0x2c>;
									phandle = <0x77>;
								};
							};

							port@1 {
								reg = <0x01>;

								typec_con_ss: endpoint {
									remote-endpoint = <0x2d>;
									phandle = <0x79>;
								};
							};
						};
					};
				};
			};

			lpi2c4: i2c@42540000 {
				compatible = "fsl,imx95-lpi2c", "fsl,imx7ulp-lpi2c";
				reg = <0x42540000 0x10000>;
				interrupts = <0x00 0x3b 0x04>;
				clocks = <0x11 0x82 0x11 0x77>;
				clock-names = "per", "ipg";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				dmas = <0x28 0x0a 0x00 0x00 0x28 0x0b 0x00 0x01>;
				dma-names = "tx", "rx";
				status = "okay";
				clock-frequency = <0x61a80>;
				pinctrl-names = "default";
				pinctrl-0 = <0x2e>;
				phandle = <0xd2>;

				pca9632: pca9632@62 {
					compatible = "nxp,pca9632";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x62>;
					nxp,inverted-out;
					phandle = <0xd3>;

					led_backlight0: led@0 {
						reg = <0x00>;
						function = "backlight";
						color = <0x00>;
						function-enumerator = <0x00>;
						phandle = <0xd4>;
					};

					led_backlight1: led@1 {
						reg = <0x01>;
						function = "backlight";
						color = <0x00>;
						function-enumerator = <0x01>;
						phandle = <0xd5>;
					};
				};

				bridge@4c {
					compatible = "ite,it6263";
					reg = <0x4c>;
					reset-gpios = <0x2f 0x17 0x01>;

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							it6263_in: endpoint {
								remote-endpoint = <0x30>;
								phandle = <0x6d>;
							};
						};

						port@1 {
							reg = <0x01>;

							it6263_out: endpoint {
								remote-endpoint = <0x31>;
								phandle = <0x95>;
							};
						};
					};
				};
			};

