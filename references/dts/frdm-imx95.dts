				msi-map = <0x00 0x7e 0x60 0x01 0x10 0x7e 0x61 0x01 0x20 0x7e 0x62 0x01 0x40 0x7e 0x63 0x01 0x50 0x7e 0x65 0x01 0x60 0x7e 0x66 0x01 0x80 0x7e 0x64 0x01 0xc0 0x7e 0x67 0x01>;
				iommu-map = <0x00 0x27 0x20 0x01 0x10 0x27 0x21 0x01 0x20 0x27 0x22 0x01 0x40 0x27 0x23 0x01 0x50 0x27 0x25 0x01 0x60 0x27 0x26 0x01 0x80 0x27 0x24 0x01 0xc0 0x27 0x27 0x01>;
				ranges = <0x82000000 0x00 0x4cc00000 0x00 0x4cc00000 0x00 0xe0000 0xc2000000 0x00 0x4cd00000 0x00 0x4cd00000 0x00 0x10000 0x82000000 0x00 0x4cd20000 0x00 0x4cd20000 0x00 0x60000 0xc2000000 0x00 0x4cd80000 0x00 0x4cd80000 0x00 0x60000>;
				#interrupt-cells = <0x01>;
				interrupt-map-mask = <0x00 0x00 0x00 0x07>;
				interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x130 0x04>;
