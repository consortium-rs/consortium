					clocks = <0x11 0x66>;
					clock-names = "ref";
					nvmem-cells = <0x82>;
					nvmem-cell-names = "mac-address";
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <0x83>;
					phy-handle = <0x84>;
					phy-mode = "rgmii-id";
					phandle = <0x134>;
				};

				enetc_port1: ethernet@8,0 {
					compatible = "pci1131,e101";
