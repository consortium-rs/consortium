					clock-names = "ref";
					nvmem-cells = <0x85>;
					nvmem-cell-names = "mac-address";
					status = "okay";
					pinctrl-names = "default";
					pinctrl-0 = <0x86>;
					phy-handle = <0x87>;
					phy-mode = "rgmii-id";
					phandle = <0x135>;
				};

				enetc_port2: ethernet@10,0 {
					compatible = "pci1131,e101";
