			compatible = "nxp,imx95-display-csr", "syscon";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x00 0x4b010000 0x00 0x10000>;
			#clock-cells = <0x01>;
			clocks = <0x11 0x4b>;
			power-domains = <0x51 0x0d>;
			assigned-clocks = <0x11 0x4c 0x11 0x4e 0x11 0x4b>;
			assigned-clock-parents = <0x11 0x09 0x11 0x09 0x11 0x0a>;
			assigned-clock-rates = <0x17d78400 0x17d78400 0x7f28155>;
			phandle = <0x6e>;

			display_pixel_link: bridge@8 {
				compatible = "nxp,imx95-dc-pixel-link";
				reg = <0x08 0x04>;
				status = "okay";
				phandle = <0x121>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						display_pixel_link0_to_pixel_interleaver_disp0: endpoint {
							remote-endpoint = <0x62>;
							phandle = <0x70>;
						};
					};

					port@1 {
						reg = <0x01>;

						display_pixel_link1_to_pixel_interleaver_disp1: endpoint {
							remote-endpoint = <0x63>;
							phandle = <0x72>;
						};
					};

					port@2 {
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						reg = <0x02>;

						display_pixel_link0_to_mipi_dsi: endpoint@0 {
							reg = <0x00>;
							remote-endpoint = <0x64>;
							phandle = <0x5b>;
						};

						display_pixel_link0_to_ldb_ch0: endpoint@1 {
							reg = <0x01>;
							remote-endpoint = <0x65>;
							phandle = <0x6a>;
						};
					};

					port@3 {
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						reg = <0x03>;

						display_pixel_link1_to_mipi_dsi: endpoint@0 {
							reg = <0x00>;
							remote-endpoint = <0x66>;
							phandle = <0x5c>;
						};

						display_pixel_link1_to_ldb_ch1: endpoint@1 {
							reg = <0x01>;
							remote-endpoint = <0x67>;
							phandle = <0x6c>;
						};
					};
				};
			};
		};

