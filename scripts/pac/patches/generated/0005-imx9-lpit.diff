Hand-corrected `consortium-pac-imx9::peripherals::lpit`: keep the CHANNEL_CVAL/CHANNEL_TCTRL per-channel arrays (used by the LPIT time driver).
The file is otherwise chiptool output; this restores the committed API on top of it.
--- a/crates/consortium-pac-imx9/src/peripherals/lpit.rs
+++ b/crates/consortium-pac-imx9/src/peripherals/lpit.rs
@@ -51,6 +51,19 @@
         assert!(n < 4usize);
         unsafe { crate::common::Reg::from_ptr(self.ptr.wrapping_add(0x20usize + n * 16usize) as _) }
     }
+    #[inline(always)]
+    pub const fn CHANNEL_CVAL(
+        self,
+        n: usize,
+    ) -> crate::common::Reg<LPIT_CVAL_TMR_CUR, crate::common::RW> {
+        assert!(n < 4usize);
+        unsafe { crate::common::Reg::from_ptr(self.ptr.wrapping_add(0x24usize + n * 16usize) as _) }
+    }
+    #[inline(always)]
+    pub const fn CHANNEL_TCTRL(self, n: usize) -> crate::common::Reg<u32, crate::common::RW> {
+        assert!(n < 4usize);
+        unsafe { crate::common::Reg::from_ptr(self.ptr.wrapping_add(0x28usize + n * 16usize) as _) }
+    }
 }
