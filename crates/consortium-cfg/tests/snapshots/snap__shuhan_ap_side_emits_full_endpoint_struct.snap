    ::consortium_shared_memory::regions::UncachedRegion, ::shared::Ping, ::shared::Pong,
    ::consortium_codec::PostcardCodec, 0u8, 1u8, 256usize,
);
::consortium_ipc_transport_memory::impl_channel!(
    PONG, ::consortium_ipc::Primary, ::consortium_ipc_doorbell_ipcc::IpccDoorbell <
    ::consortium_ipc::Primary, 2usize >,
    ::consortium_shared_memory::regions::UncachedRegion, ::shared::Telemetry,
    ::shared::Command, ::consortium_codec::RkyvCodec < 512usize >, 2u8, 3u8, 512usize,
);
fn __consortium_install_channels(
    uio: &[::std::sync::Arc<::consortium_runtime_app::uio::UioDevice>],
) -> ::core::result::Result<(), ::consortium_runtime_app::uio::UioDeviceError> {
    let mut transport = {
        // SAFETY: automatically generated by Consortium after matching with database
        let region = unsafe {
            ::consortium_shared_memory::regions::UncachedRegion::new(
                (uio[0usize].mmap_zeroed(1usize)?) as *mut u8,
                32768usize,
            )
        };
        // SAFETY: the base is the UIO-mapped doorbell register window,
        // resolved from the validated Consortium hardware database.
        let doorbell = unsafe {
            ::consortium_ipc_doorbell_ipcc::IpccDoorbell::<
                ::consortium_ipc::Primary,
                1usize,
            >::new_mapped(uio[0usize].mmap(2usize)?)
        };
        let __service_db = doorbell.clone();
        uio[0usize]
            .bind_service(
                ::std::sync::Arc::new(move || {
                    __service_db.notify_rx_occupied_interrupt()
                }),
            );
        // SAFETY: doorbell channel is verified to be valid in the config.
        let chan_tx = unsafe { ::consortium_ipc::Chan::new_unchecked(0u8) };
        // SAFETY: doorbell channel is verified to be valid in the config.
        let chan_rx = unsafe { ::consortium_ipc::Chan::new_unchecked(1u8) };
        // SAFETY: the base is offset 0x00 of the validated shared-memory
        // region, and the channels/doorbell/region are this side's.
        unsafe {
            ::consortium_ipc_transport_memory::SharedMemoryTransport::<
                ::consortium_ipc::Primary,
                _,
                _,
            >::new(
                chan_tx,
                chan_rx,
                doorbell,
                region,
                (uio[0usize].mmap(1usize)?) as *mut u8,
            )
        }
    };
    transport.keep_alive(uio[0usize].clone());
    transport.keep_alive(uio[0usize].clone());
    ::consortium_ipc_transport_memory::install::<channels::PING>(transport);
    let mut transport = {
        // SAFETY: automatically generated by Consortium after matching with database
        let region = unsafe {
            ::consortium_shared_memory::regions::UncachedRegion::new(
                (uio[0usize].mmap_zeroed(1usize)?) as *mut u8,
                16384usize,
            )
        };
        // SAFETY: the base is the UIO-mapped doorbell register window,
        // resolved from the validated Consortium hardware database.
        let doorbell = unsafe {
            ::consortium_ipc_doorbell_ipcc::IpccDoorbell::<
                ::consortium_ipc::Primary,
                2usize,
            >::new_mapped(uio[2usize].mmap(0usize)?)
        };
        let __service_db = doorbell.clone();
        uio[2usize]
            .bind_service(
                ::std::sync::Arc::new(move || {
                    __service_db.notify_rx_occupied_interrupt()
                }),
            );
        // SAFETY: doorbell channel is verified to be valid in the config.
        let chan_tx = unsafe { ::consortium_ipc::Chan::new_unchecked(2u8) };
        // SAFETY: doorbell channel is verified to be valid in the config.
        let chan_rx = unsafe { ::consortium_ipc::Chan::new_unchecked(3u8) };
        // SAFETY: the base is offset 0x00 of the validated shared-memory
        // region, and the channels/doorbell/region are this side's.
        unsafe {
            ::consortium_ipc_transport_memory::SharedMemoryTransport::<
                ::consortium_ipc::Primary,
                _,
                _,
            >::new(
                chan_tx,
                chan_rx,
                doorbell,
                region,
                (uio[0usize].mmap(1usize)?) as *mut u8,
            )
        }
    };
    transport.keep_alive(uio[0usize].clone());
    transport.keep_alive(uio[2usize].clone());
    ::consortium_ipc_transport_memory::install::<channels::PONG>(transport);
    ::core::result::Result::Ok(())
}
