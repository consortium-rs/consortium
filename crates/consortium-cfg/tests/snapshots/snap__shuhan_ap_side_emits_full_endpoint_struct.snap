/// Descriptor-handshake failure, with the doorbell-specific payload
/// erased so a single error type spans transceivers that use
/// different doorbells. `no_std`-safe (no `alloc`).
///
/// The `Descriptor` payload is surfaced through `Debug` in the
/// consuming binary, which dead-code analysis cannot see, so allow
/// the otherwise-"never read" field.
#[derive(Debug)]
#[allow(dead_code)]
enum ConsortiumConnectError {
    /// The descriptor header/channel table was invalid or never reached
    /// the ready state.
    Descriptor(::consortium_ipc_transport_memory::DescriptorError),
    /// The doorbell signal failed during the handshake.
    Doorbell,
    /// Any other transport error during the handshake.
    Other,
}
/// IPC endpoints that have been *constructed* but not yet connected.
/// Call [`connect`](IpcMemoryEndpoints::connect) to run the descriptor
/// handshake and obtain usable transceivers.
struct IpcMemoryEndpoints {
    ping: ::consortium_ipc_transport_memory::SharedMemoryTransport<
        ::consortium_ipc::Primary,
        ::consortium_ipc_doorbell_hsem::HsemDoorbell<::consortium_ipc::Primary, 1usize>,
        ::consortium_shared_memory::regions::UncachedRegion,
    >,
    pong: ::consortium_ipc_transport_memory::SharedMemoryTransport<
        ::consortium_ipc::Primary,
        ::consortium_ipc_doorbell_ipcc::IpccDoorbell<::consortium_ipc::Primary, 2usize>,
        ::consortium_shared_memory::regions::UncachedRegion,
    >,
}
static mut PING_TX_BUF: [u8; 256usize] = [0u8; 256usize];
static mut PING_RX_BUF: [u8; 256usize] = [0u8; 256usize];
static mut PONG_TX_BUF: [u8; 512usize] = [0u8; 512usize];
static mut PONG_RX_BUF: [u8; 512usize] = [0u8; 512usize];
/// Connected IPC endpoints: each field is a ready-to-use transceiver.
struct IpcMemoryEndpointsConnected {
    ping: ::consortium_ipc::Transceiver<
        ::shared::Ping,
        ::shared::Pong,
        ::consortium_ipc_transport_memory::SharedMemoryTransportTx<
            ::consortium_ipc_transport_memory::Primary,
            ::consortium_ipc_doorbell_hsem::HsemDoorbell<
                ::consortium_ipc::Primary,
                1usize,
            >,
            ::consortium_shared_memory::regions::UncachedRegion,
        >,
        ::consortium_ipc_transport_memory::SharedMemoryTransportRx<
            ::consortium_ipc_transport_memory::Primary,
            ::consortium_ipc_doorbell_hsem::HsemDoorbell<
                ::consortium_ipc::Primary,
                1usize,
            >,
            ::consortium_shared_memory::regions::UncachedRegion,
        >,
        ::consortium_codec::PostcardCodec,
    >,
    pong: ::consortium_ipc::Transceiver<
        ::shared::Telemetry,
        ::shared::Command,
        ::consortium_ipc_transport_memory::SharedMemoryTransportTx<
            ::consortium_ipc_transport_memory::Primary,
            ::consortium_ipc_doorbell_ipcc::IpccDoorbell<
                ::consortium_ipc::Primary,
                2usize,
            >,
            ::consortium_shared_memory::regions::UncachedRegion,
        >,
        ::consortium_ipc_transport_memory::SharedMemoryTransportRx<
            ::consortium_ipc_transport_memory::Primary,
            ::consortium_ipc_doorbell_ipcc::IpccDoorbell<
                ::consortium_ipc::Primary,
                2usize,
            >,
            ::consortium_shared_memory::regions::UncachedRegion,
        >,
        ::consortium_codec::RkyvCodec<512usize>,
    >,
}
impl IpcMemoryEndpoints {
    fn new(
        uio: &[::consortium_runtime_app::uio::UioDevice],
    ) -> ::core::result::Result<Self, ::consortium_runtime_app::uio::UioDeviceError> {
        ::core::result::Result::Ok(Self {
            ping: {
                // SAFETY: automatically generated by Consortium after matching with database
                let region = unsafe {
                    ::consortium_shared_memory::regions::UncachedRegion::new(
                        (uio[0usize].mmap_zeroed(1usize)?) as *mut u8,
                        32768usize,
                    )
                };
                // SAFETY: the base is the UIO-mapped doorbell register window,
                // resolved from the validated Consortium hardware database.
                let doorbell = unsafe {
                    ::consortium_ipc_doorbell_hsem::HsemDoorbell::<
                        ::consortium_ipc::Primary,
                        1usize,
                    >::new_mapped(uio[0usize].mmap(2usize)?)
                };
                uio[0usize].bind_notifier(doorbell.notifier());
                // SAFETY: doorbell channel is verified to be valid in the config.
                let chan_tx = unsafe { ::consortium_ipc::Chan::new_unchecked(0u8) };
                // SAFETY: doorbell channel is verified to be valid in the config.
                let chan_rx = unsafe { ::consortium_ipc::Chan::new_unchecked(1u8) };
                // SAFETY: the base is offset 0x00 of the validated shared-memory
                // region, and the channels/doorbell/region are this side's.
                unsafe {
                    ::consortium_ipc_transport_memory::SharedMemoryTransport::<
                        ::consortium_ipc::Primary,
                        _,
                        _,
                    >::new(
                        chan_tx,
                        chan_rx,
                        doorbell,
                        region,
                        (uio[0usize].mmap(1usize)?) as *mut u8,
                    )
                }
            },
            pong: {
                // SAFETY: automatically generated by Consortium after matching with database
                let region = unsafe {
                    ::consortium_shared_memory::regions::UncachedRegion::new(
                        (uio[0usize].mmap_zeroed(1usize)?) as *mut u8,
                        16384usize,
                    )
                };
                // SAFETY: the base is the UIO-mapped doorbell register window,
                // resolved from the validated Consortium hardware database.
                let doorbell = unsafe {
                    ::consortium_ipc_doorbell_ipcc::IpccDoorbell::<
                        ::consortium_ipc::Primary,
                        2usize,
                    >::new_mapped(uio[2usize].mmap(0usize)?)
                };
                let __service_db = doorbell.clone();
                uio[2usize]
                    .bind_service(
                        ::std::sync::Arc::new(move || {
                            __service_db.notify_rx_occupied_interrupt()
                        }),
                    );
                // SAFETY: doorbell channel is verified to be valid in the config.
                let chan_tx = unsafe { ::consortium_ipc::Chan::new_unchecked(2u8) };
                // SAFETY: doorbell channel is verified to be valid in the config.
                let chan_rx = unsafe { ::consortium_ipc::Chan::new_unchecked(3u8) };
                // SAFETY: the base is offset 0x00 of the validated shared-memory
                // region, and the channels/doorbell/region are this side's.
                unsafe {
                    ::consortium_ipc_transport_memory::SharedMemoryTransport::<
                        ::consortium_ipc::Primary,
                        _,
                        _,
                    >::new(
                        chan_tx,
                        chan_rx,
                        doorbell,
                        region,
                        (uio[0usize].mmap(1usize)?) as *mut u8,
                    )
                }
            },
        })
    }
    /// Runs the descriptor handshake for every transceiver and returns
    /// the connected endpoints. Each transceiver's primary side writes
    /// and the secondary side acks the descriptor before any traffic.
    async fn connect(
        self,
    ) -> ::core::result::Result<IpcMemoryEndpointsConnected, ConsortiumConnectError> {
        ::core::result::Result::Ok(IpcMemoryEndpointsConnected {
            ping: {
                let mut transport = self.ping;
                let (chan_tx, chan_rx) = transport.channels();
                ::consortium_ipc::Connect::connect(
                        &mut transport,
                        ::consortium_ipc_transport_memory::DescriptorLayout::new(
                            2u8,
                            256usize,
                        ),
                    )
                    .await
                    .map_err(|__e| match __e {
                        ::consortium_ipc_transport_memory::Error::Descriptor(__d) => {
                            ConsortiumConnectError::Descriptor(__d)
                        }
                        ::consortium_ipc_transport_memory::Error::Doorbell(_) => {
                            ConsortiumConnectError::Doorbell
                        }
                        _ => ConsortiumConnectError::Other,
                    })?;
                let (t_tx, t_rx) = transport.split();
                let channel_tx = ::consortium_ipc::Channel::<
                    ::consortium_ipc::Tx,
                    ::shared::Ping,
                    _,
                    ::consortium_codec::PostcardCodec,
                >::new(
                    chan_tx,
                    t_tx,
                    {
                        // SAFETY: module-level static scratch buffer, borrowed once
                        // during initialization and never aliased afterwards.
                        unsafe { &mut *::core::ptr::addr_of_mut!(PING_TX_BUF) }
                    },
                );
                let channel_rx = ::consortium_ipc::Channel::<
                    ::consortium_ipc::Rx,
                    ::shared::Pong,
                    _,
                    ::consortium_codec::PostcardCodec,
                >::new(
                    chan_rx,
                    t_rx,
                    {
                        // SAFETY: module-level static scratch buffer, borrowed once
                        // during initialization and never aliased afterwards.
                        unsafe { &mut *::core::ptr::addr_of_mut!(PING_RX_BUF) }
                    },
                );
                ::consortium_ipc::Transceiver::new(channel_tx, channel_rx)
            },
            pong: {
                let mut transport = self.pong;
                let (chan_tx, chan_rx) = transport.channels();
                ::consortium_ipc::Connect::connect(
                        &mut transport,
                        ::consortium_ipc_transport_memory::DescriptorLayout::new(
                            2u8,
                            512usize,
                        ),
                    )
                    .await
                    .map_err(|__e| match __e {
                        ::consortium_ipc_transport_memory::Error::Descriptor(__d) => {
                            ConsortiumConnectError::Descriptor(__d)
                        }
                        ::consortium_ipc_transport_memory::Error::Doorbell(_) => {
                            ConsortiumConnectError::Doorbell
                        }
                        _ => ConsortiumConnectError::Other,
                    })?;
                let (t_tx, t_rx) = transport.split();
                let channel_tx = ::consortium_ipc::Channel::<
                    ::consortium_ipc::Tx,
                    ::shared::Telemetry,
                    _,
                    ::consortium_codec::RkyvCodec<512usize>,
                >::new(
                    chan_tx,
                    t_tx,
                    {
                        // SAFETY: module-level static scratch buffer, borrowed once
                        // during initialization and never aliased afterwards.
                        unsafe { &mut *::core::ptr::addr_of_mut!(PONG_TX_BUF) }
                    },
                );
                let channel_rx = ::consortium_ipc::Channel::<
                    ::consortium_ipc::Rx,
                    ::shared::Command,
                    _,
                    ::consortium_codec::RkyvCodec<512usize>,
                >::new(
                    chan_rx,
                    t_rx,
                    {
                        // SAFETY: module-level static scratch buffer, borrowed once
                        // during initialization and never aliased afterwards.
                        unsafe { &mut *::core::ptr::addr_of_mut!(PONG_RX_BUF) }
                    },
                );
                ::consortium_ipc::Transceiver::new(channel_tx, channel_rx)
            },
        })
    }
}
