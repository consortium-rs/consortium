## UIO Definition

### reserved-memory

```dts
reserved-memory {
    #address-cells = <2>;
    #size-cells = <2>;
    ranges;

    dbg_shm: dbg-shm@20480000 {
        reg = <0x0 0x20480000 0x0 0x2000>;
        no-map;
    };

    ipc_shm_0: ipc-shm@20484000 {
        reg = <0x0 0x20484000 0x0 0x4000>;
        no-map;
    };

    ipc_shm_1: ipc-shm@20488000 {
        reg = <0x0 0x20488000 0x0 0x4000>;
        no-map;
    };
};
```

### dbg-shm

```dts
dbg-shm@20480000 {
    compatible = "generic-uio";
    memory-region = <&dbg_shm>;
    status = "okay";
};
```

### ipc-shm

```dts
ipc-shm@20484000 {
    compatible = "generic-uio";
    memory-region = <&ipc_shm_0 &ipc_shm_1>;
    status = "okay";
};
```

### mu7

```dts
mu7@42430000 {
    compatible = "generic-uio";
    reg = <0x0 0x42430000 0x0 0x20000>;
    interrupt-parent = <&gic>;
    interrupts = <GIC_SPI 234 IRQ_TYPE_LEVEL_HIGH>;
    status = "okay";
};
```

### mu1

```dts
mu1@44220000 {
    compatible = "generic-uio";
    reg = <0x0 0x44220000 0x0 0x20000>;
    interrupt-parent = <&gic>;
    interrupts = <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>;
    status = "okay";
};
```

## NVIC Initialization

### cm33

```rust
fn _generated() {
    #[derive(Clone, Copy, Debug, Eq, PartialEq)]
    #[repr(u16)]
    pub enum BellaInterrupt {
        MU1 = 225u16,
    }
    unsafe impl ::cortex_m::interrupt::InterruptNumber for BellaInterrupt {
        fn number(self) -> u16 {
            self as u16
        }
    }
    // SAFETY: interrupt numbers are emitted from the validated
    // Consortium hardware database for this visible core.
    unsafe {
        ::consortium_hal_imx9::hal::nvic::set_priority(BellaInterrupt::MU1 as u16, 0x80);
    }
    ::consortium_runtime_mcu::log::trace!(
        "consortium controller init: NVIC set priority to 0x80 {} (id={})",
        stringify!(MU1), BellaInterrupt::MU1 as u32
    );
    ::cortex_m::peripheral::NVIC::unpend(BellaInterrupt::MU1);
    ::consortium_runtime_mcu::log::trace!(
        "consortium controller init: NVIC unpend {} (id={})", stringify!(MU1),
        BellaInterrupt::MU1 as u32
    );
    // SAFETY: interrupt numbers are emitted from the validated
    // Consortium hardware database for this visible core.
    unsafe {
        ::cortex_m::peripheral::NVIC::unmask(BellaInterrupt::MU1);
    }
    ::consortium_runtime_mcu::log::trace!(
        "consortium controller init: NVIC unmask {} (id={})", stringify!(MU1),
        BellaInterrupt::MU1 as u32
    );
}
