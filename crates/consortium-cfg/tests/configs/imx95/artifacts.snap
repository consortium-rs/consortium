fn _generated() {
    ::consortium_hal_imx9::hal::nvic::unpend(::consortium_hal_imx9::Interrupt::MU7_B);
    // SAFETY: the interrupt comes from the validated Consortium
    // hardware database for this visible core, and the application
    // owns the matching vector.
    unsafe {
        ::consortium_hal_imx9::hal::nvic::set_priority(
            ::consortium_hal_imx9::Interrupt::MU7_B,
            0x80u8,
        );
        ::consortium_hal_imx9::hal::nvic::enable(
            ::consortium_hal_imx9::Interrupt::MU7_B,
        );
    }
    ::consortium_runtime_mcu::log::trace!(
        "consortium controller init: NVIC enabled {} at priority 0x80 (id={})", "MU7_B",
        207u32
    );
    ::consortium_hal_imx9::hal::nvic::unpend(::consortium_hal_imx9::Interrupt::MU8_B);
    // SAFETY: the interrupt comes from the validated Consortium
    // hardware database for this visible core, and the application
    // owns the matching vector.
    unsafe {
        ::consortium_hal_imx9::hal::nvic::set_priority(
            ::consortium_hal_imx9::Interrupt::MU8_B,
            0x80u8,
        );
        ::consortium_hal_imx9::hal::nvic::enable(
            ::consortium_hal_imx9::Interrupt::MU8_B,
        );
    }
    ::consortium_runtime_mcu::log::trace!(
        "consortium controller init: NVIC enabled {} at priority 0x80 (id={})", "MU8_B",
        208u32
    );
}
