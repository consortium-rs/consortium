# Generated artifacts

## UIO Definition

### reserved-memory

```dts
reserved-memory {
    #address-cells = <2>;
    #size-cells = <2>;
    ranges;

    dbg_shm: dbg-shm@20062000 {
        reg = <0x0 0x20062000 0x0 0x2000>;
        no-map;
    };

    ipc_shm_0: ipc-shm@20064000 {
        reg = <0x0 0x20064000 0x0 0x4000>;
        no-map;
    };

    ipc_shm_1: ipc-shm@200c4000 {
        reg = <0x0 0x200c4000 0x0 0x4000>;
        no-map;
    };
};
```

### dbg-shm

```dts
dbg-shm@20062000 {
    compatible = "generic-uio";
    linux,uio-name = "dbg-shm";
    memory-region = <&dbg_shm>;
    status = "okay";
};
```

### ipc-shm

```dts
ipc-shm@20064000 {
    compatible = "generic-uio";
    linux,uio-name = "ipc-shm";
    memory-region = <&ipc_shm_0 &ipc_shm_1>;
    status = "okay";
};
```

### ipcc1

```dts
ipcc1@40490000 {
    compatible = "generic-uio";
    linux,uio-name = "ipcc1";
    reg = <0x0 0x40490000 0x0 0x400>;
    interrupt-parent = <&intc>;
    interrupts = <GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&scmi_clk CK_SCMI_IPCC1>;
    status = "okay";
};
```

### ipcc2

```dts
ipcc2@46250000 {
    compatible = "generic-uio";
    linux,uio-name = "ipcc2";
    reg = <0x0 0x46250000 0x0 0x400>;
    interrupt-parent = <&intc>;
    interrupts = <GIC_SPI 175 IRQ_TYPE_LEVEL_HIGH>;
    clocks = <&scmi_clk CK_SCMI_IPCC2>;
    status = "okay";
};
