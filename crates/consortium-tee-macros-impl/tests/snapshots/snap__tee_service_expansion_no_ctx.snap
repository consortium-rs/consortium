// Input:
consortium_tee::tee_service! {
    commands { ping, echo_bytes, hello }
}

// Expands to:
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
#[repr(u32)]
pub enum Command {
    Ping = 0,
    EchoBytes = 1,
    Hello = 2,
    #[default]
    Unknown = 3,
}
impl From<u32> for Command {
    fn from(val: u32) -> Self {
        match val {
            0 => Command::Ping,
            1 => Command::EchoBytes,
            2 => Command::Hello,
            _ => Command::Unknown,
        }
    }
}
impl From<Command> for u32 {
    fn from(cmd: Command) -> Self {
        cmd as u32
    }
}
#[cfg(feature = "ta")]
pub fn invoke_command(
    cmd: u32,
    params: &mut ::optee_utee::ParametersAny<'_>,
) -> ::optee_utee::Result<()> {
    match Command::from(cmd) {
        Command::Ping => ping_dispatched(params),
        Command::EchoBytes => echo_bytes_dispatched(params),
        Command::Hello => hello_dispatched(params),
        Command::Unknown => Err(::optee_utee::ErrorKind::BadParameters.into()),
    }
}
