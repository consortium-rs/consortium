fn on_fail(err: ConsortiumInitError) {
    defmt::error!("init failed: {}", err);
}
/// Consortium init-failure dispatcher. Shadows the runtime crate's
/// glob-imported fallback so `#[main]` routes `init()` errors here.
#[allow(unreachable_code)]
fn __consortium_init_fail(__consortium_err: ConsortiumInitError) -> ! {
    on_fail(__consortium_err);
    loop {
        ::cortex_m::asm::wfi();
    }
}
